generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  fullName  String?   @map("full_name")
  planTier  String?   @map("plan_tier")
  status    String?
  createdAt DateTime? @map("created_at")
  quotaUsed Int?      @map("quota_used")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  price         Int
  reelsPerMonth Int      @map("reels_per_month")
  perks         Json?
}

model Subscription {
  id                       String   @id @default(uuid())
  userId                   String   @map("user_id")
  provider                 String
  planTier                 String   @map("plan_tier")
  status                   String
  providerSubscriptionId   String?  @map("provider_subscription_id")
  metadata                 Json?
  createdAt                DateTime @map("created_at")
}

model ActivityLog {
  id               String   @id @default(uuid())
  userName         String?  @map("user_name")
  actionDescription String? @map("action_description")
  planTier         String?  @map("plan_tier")
  metadata         Json?
  createdAt        DateTime @map("created_at")
}

model Script {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  personaId   String?   @map("persona_id")
  platform    String?
  tone        String?
  style       String?
  durationSec Int?      @map("duration_sec")
  inputPrompt String?   @map("input_prompt")
  text        String
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@index([userId], map: "scripts_user_idx")
  @@map("scripts")
}

model Reel {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  scriptId      String    @map("script_id")
  personaId     String?   @map("persona_id")
  platform      String?
  tone          String?
  style         String?
  durationSec   Int?      @map("duration_sec")
  status        String?
  rendererJobId String?   @map("renderer_job_id")
  videoUrl      String?   @map("video_url")
  thumbnailUrl  String?   @map("thumbnail_url")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@index([userId], map: "reels_user_idx")
  @@index([scriptId], map: "reels_script_idx")
  @@index([rendererJobId], map: "reels_renderer_job_idx")
  @@map("reels")
}
